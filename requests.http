# BarberOS API — REST Client requests
# Install "REST Client" extension by Huachao Mao in VS Code
# Click "Send Request" above any request to run it
# Change @phone and @myPhone to your real number

@baseUrl = http://localhost:4000/api/v1
@myPhone = +9647802431955

