@refreshToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6ImNtb2lwMDRwOTAwMDNjcDR1OXphc3VndTEiLCJyb2xlIjoiQ1VTVE9NRVIiLCJpYXQiOjE3NzczODQ3NzQsImV4cCI  6MTc3Nzk4OTU3NH0.GkXVvuRS4LY0OotbhBddY2BLIasXyeoKNzchZ36nsr0


# ════════════════════════════════════════════════
#  S2 — Auth
# ════════════════════════════════════════════════

### S2.3 — Request OTP (sends WhatsApp message)
POST {{baseUrl}}/auth/request-otp
Content-Type: application/json

{
  "phone": "{{myPhone}}"
}

###

### S2.4a — Register as Customer (first time)
# Run request-otp first, then paste the code you received
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "phone": "{{myPhone}}",
  "otp": "952897",
  "name": "Ahmed",
  "isRegister": true
}

###

### S2.4b — Register as Shop Owner (first time)
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "phone": "{{myPhone}}",
  "otp": "PASTE_OTP_HERE",
  "name": "Ahmed",
  "shopName": "My Barbershop",
  "isRegister": true
}

###

### S2.4c — Login (existing user)
POST {{baseUrl}}/auth/verify-otp
Content-Type: application/json

{
  "phone": "{{myPhone}}",
  "otp": "PASTE_OTP_HERE"
}

###

### S2.5 — Refresh access token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

### S2.6 — Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

### S2.7 — Get current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}

###

# ════════════════════════════════════════════════
#  S3 — Shops & Discovery
# ════════════════════════════════════════════════

### S3.2 — List shops (public)
GET {{baseUrl}}/shops

###

### S3.2 — List shops with filters
GET {{baseUrl}}/shops?search=barber&city=Baghdad&priceRange=MID&limit=20&offset=0

###

### S3.2 — List shops with distance (provide your GPS coords)
GET {{baseUrl}}/shops?lat=33.34&lng=44.40

###

### S2.10 — Get shop approval status (Owner JWT)
GET {{baseUrl}}/shop/status
Authorization: Bearer {{accessToken}}

###

### S2.9a — Generate barber invite (Owner JWT)
POST {{baseUrl}}/auth/invite/generate
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "nameEn": "Ahmed",
  "nameAr": "أحمد"
}

###

### S2.9b — Get invite info (public)
GET {{baseUrl}}/auth/invite?code=PASTE_CODE_HERE

###

### S2.9c — Accept invite (public — barber completes OTP first)
POST {{baseUrl}}/auth/invite/accept
Content-Type: application/json

{
  "code": "PASTE_CODE_HERE",
  "phone": "{{myPhone}}",
  "otp": "PASTE_OTP_HERE"
}

###

### Health check
GET http://localhost:4000/health
