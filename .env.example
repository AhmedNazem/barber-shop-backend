# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_TEST=postgresql://user:password@host/dbname_test?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_32_plus_char_hex_string
JWT_REFRESH_SECRET=replace_with_different_32_plus_char_hex_string

# ─── Encryption (AES-256 for SMS API key at rest) ────────────────────────────
# Must be exactly 32 characters
ENCRYPTION_KEY=replace_with_exactly_32_char_hex

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
REDIS_URL=rediss://default:password@host.upstash.io:6380

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── S3 Storage ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=me-south-1
AWS_BUCKET_NAME=barberos-uploads

# ─── AI (Google AI Studio — aistudio.google.com → Get API key) ───────────────
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── SMS (configured via admin panel after launch) ────────────────────────────
# Unifonic: SMS_API_KEY=AppSid, SMS_SENDER_ID=SenderID (leave SMS_API_SECRET blank)
# Twilio:   SMS_API_KEY=AccountSid, SMS_API_SECRET=AuthToken, SMS_SENDER_ID=+1234... or whatsapp:+1234...
SMS_PROVIDER=unifonic
SMS_API_KEY=your_unifonic_appsid_or_twilio_account_sid
SMS_API_SECRET=your_twilio_auth_token
SMS_SENDER_ID=BarberOS

# ─── Payment Gateways (Iraqi) ─────────────────────────────────────────────────
ZAINCASH_MERCHANT_ID=your_merchant_id
ZAINCASH_SECRET=your_zaincash_secret

FIB_CLIENT_ID=your_fib_client_id
FIB_CLIENT_SECRET=your_fib_client_secret

PAYTABS_PROFILE_ID=your_profile_id
PAYTABS_SERVER_KEY=your_server_key
